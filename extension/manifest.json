{
  "manifest_version": 3,
  "name": "Claude Usage Reporter",
  "version": "3.0.0",
  "description": "Pushes Claude plan usage and month-to-date API spend to a local menu bar server.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Claude Cost Reporter"
  },
  "permissions": [],
  "host_permissions": [
    "https://claude.ai/*",
    "https://platform.claude.com/workspaces/*/cost*",
    "http://localhost:7823/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["usage.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://platform.claude.com/workspaces/*/cost*"],
      "js": ["cost.js"],
      "run_at": "document_idle"
    }
  ]
}
